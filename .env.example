# ==============================================================================
# JudgeAI Environment Variables Configuration (Example / Template)
# Copy this file to .env and adjust values for your local or production environment.
# ==============================================================================

# Authentication & Security
AUTH_HOST=0.0.0.0
AUTH_PORT=8004
JWT_SECRET_KEY=replace-with-a-long-random-secret-key-32-chars-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Resend Email Integration (Phase 2)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=JudgeAI

# OTP & Password Reset Security
EMAIL_OTP_EXPIRY_MINUTES=10
EMAIL_OTP_RESEND_COOLDOWN_SECONDS=60
EMAIL_OTP_MAX_ATTEMPTS=5
PASSWORD_RESET_EXPIRY_MINUTES=30

# MongoDB Database Connections
MONGODB_URI=mongodb://localhost:27017
MONGODB_AUTH_DB_NAME=judgeai_auth
MONGODB_EVAL_DB_NAME=judgeai_evaluations
MONGODB_DB_NAME=judgeai_chat

# LLM Inference Providers
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
OLLAMA_MODEL=gpt-oss:120b-cloud
USE_OLLAMA=true

MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_MODEL=MiniMax-Text-01

# Frontend Configuration
FRONTEND_URL=http://localhost:8443
VITE_AUTH_API_URL=http://localhost:8004

# Google & GitHub OAuth Integration (Phase 3)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8004/auth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8004/auth/github/callback
