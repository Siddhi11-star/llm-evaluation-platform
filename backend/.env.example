# Application Configuration
PROJECT_NAME="JudgeAI Evaluation Platform"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Database Configuration (MongoDB / Motor)
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DB_NAME="judgeai_eval"

# Security & JWT Authentication
# In production, replace with a strong random secret key (e.g. openssl rand -hex 32)
JWT_SECRET_KEY="development_jwt_secret_key_change_in_production_judgeai_eval_platform"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Configuration (Origins permitted for Vite Frontend)
# Can be a JSON array string or comma-separated URLs
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://localhost:8443", "http://127.0.0.1:5173", "http://127.0.0.1:8443"]

# MongoDB Atlas Vector Search Settings
VECTOR_SEARCH_INDEX_NAME="task_embeddings_vector_index"
EMBEDDING_DIMENSION=1536
EMBEDDING_SIMILARITY_METRIC="cosine"
